# Sonora API — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Last.fm API (https://www.last.fm/api)
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_SHARED_SECRET=your-lastfm-shared-secret
LASTFM_API_URL=https://ws.audioscrobbler.com/2.0/

# Server
PORT=3000
# Comma-separated origins allowed by CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Database (Supabase Postgres — use the Transaction pooler URL)
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# Google Gemini (for AI recommendations / mood mixes)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional override; default is gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Sentry error tracking (optional — leave empty to disable)
# https://sentry.io
SENTRY_DSN=
